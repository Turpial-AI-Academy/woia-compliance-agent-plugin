{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WOIA compliance command",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action",
    "operation_id",
    "organization",
    "resource",
    "purpose",
    "payload"
  ],
  "properties": {
    "action": {
      "enum": [
        "compliance.review",
        "compliance.decision.record",
        "compliance.exception.record",
        "compliance.hold.record",
        "compliance.retention.resolve"
      ]
    },
    "operation_id": {
      "type": "string",
      "minLength": 1
    },
    "organization": {
      "type": "string",
      "minLength": 1
    },
    "resource": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
